[Unit]
Description=JLTube parked-only safety broker and player
After=mgu-uplink.service

[Service]
Type=simple
UMask=0022
ExecStartPre=/var/opt/mgu-python/current/bin/python3 /var/opt/jltube-player/current/player.py prepare
ExecStart=/usr/bin/unshare -m /bin/sh /var/opt/jltube-player/current/run.sh
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=3
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
MemoryMax=192M
TasksMax=32
LimitNOFILE=128

[Install]
WantedBy=multi-user.target
