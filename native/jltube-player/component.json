{
  "id": "jltube-player", "kind": "tool", "version": "0.4.0",
  "title": "JLTube Player (development)",
  "description": "Parked-only safety broker; requires validated vehicle adapter and separately pinned media runtimes",
  "mguHmi": ["ID7", "ID8"], "optional": true, "uninstallable": true,
  "requires": {"mgu-uplink": "0.7.3", "mgu-python": "1.0.2", "mgu-render": "0.6.10", "mgu-deploy": "0.7.0"},
  "check": ["compat-check.js"],
  "files": [
    {"path": "player.py", "from": "player.py", "mode": "0644"},
    {"path": "vehicle_bridge.js", "from": "vehicle_bridge.js", "mode": "0644"},
    {"path": "preflight.py", "from": "preflight.py", "mode": "0644"},
    {"path": "compat-check.js", "from": "compat-check.js", "mode": "0644"},
    {"path": "run.sh", "from": "run.sh", "mode": "0755"}
  ],
  "units": [{"name": "jltube-player.service", "from": "jltube-player.service"}],
  "enable": [{"unit": "jltube-player.service", "target": "multi-user.target"}],
  "recmgr": ["jltube-player"], "restart": ["jltube-player.service"],
  "internet": true, "uids": [3921]
}
